# ============================================================
# ClickHouse Cluster — Environment Configuration
# Copy this file to .env before running docker compose up
# Never commit .env to git
# ============================================================

# ClickHouse version — pin to LTS for stability
CLICKHOUSE_VERSION=26.5

# Cluster credentials
# Change these in your local .env — never use defaults in demos
CLICKHOUSE_USER=dev_user
CLICKHOUSE_PASSWORD=dev_password
CLICKHOUSE_READONLY_USER=readonly_user
CLICKHOUSE_READONLY_PASSWORD=readonly_password

# Cluster name — must match what's in cluster.xml
CLICKHOUSE_CLUSTER=ch_cluster

# ClickHouse node ports (HTTP / TCP)
CH_NODE01_HTTP=8123
CH_NODE01_TCP=9000
CH_NODE02_HTTP=8124
CH_NODE02_TCP=9001
CH_NODE03_HTTP=8125
CH_NODE03_TCP=9002
CH_NODE04_HTTP=8126
CH_NODE04_TCP=9003

# Keeper ports (client port — what CH nodes connect to)
KEEPER01_PORT=9181
KEEPER02_PORT=9182
KEEPER03_PORT=9183