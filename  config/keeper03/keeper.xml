<?xml version="1.0"?>
<clickhouse>
    <keeper_server>
        <!-- This node's identity -->
        <server_id>3</server_id>

        <!-- Where CH nodes connect to reach Keeper -->
        <tcp_port>9183</tcp_port>

        <!-- Where Keeper stores its state -->
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>

        <coordination_settings>
            <!-- How long before a follower calls a new election (ms) -->
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>

        <!-- All 3 Keeper nodes — must be identical across all keeper configs -->
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>keeper-01</hostname>   <!-- Docker service name -->
                <port>9234</port>                <!-- Raft port, internal only -->
            </server>
            <server>
                <id>2</id>
                <hostname>keeper-02</hostname>
                <port>9234</port>
            </server>
            <server>
                <id>3</id>
                <hostname>keeper-03</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
</clickhouse>